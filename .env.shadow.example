# 双量化只读 Shadow 示例。复制为 .env.shadow 后填真实路径/URL。
# 不要写入币所或券商密钥。不要提交 .env.shadow。

DSH_ENV=development
DSH_LOCAL_PAPER=0
QUANT_GATEWAY_READ_ONLY=1
DSH_CRYPTO_MODE=shadow
DSH_A_SHARE_MODE=shadow

# 独立输出目录。Gateway 只读此目录，不要与 Paper 共用。
QUANT_GATEWAY_SNAPSHOT_DIR=.data/shadow-snapshots

# 服务身份只有 read。写路径必须 403。
QUANT_GATEWAY_API_KEYS=shadow-read/shadow-reader:read
QUANT_GATEWAY_API_KEY=shadow-read

QUANT_GATEWAY_URL=http://127.0.0.1:8001
PROJECTION_API_URL=http://127.0.0.1:8004
RISK_POLICY_URL=http://127.0.0.1:8003

PAPER_CRYPTO_ACCOUNT_ID=paper-crypto-001
PAPER_A_SHARE_ACCOUNT_ID=paper-a-share-001
DSH_CRYPTO_ACCOUNT_ID=paper-crypto-001
DSH_A_SHARE_ACCOUNT_ID=paper-a-share-001

# Crypto：6celue state.json 绝对路径。不要填 8501 Streamlit。
DSH_CRYPTO_STATE_JSON=
DSH_CRYPTO_SOURCE_SYSTEM=6celue_v5
DSH_CRYPTO_SOURCE_MODE=demo

# A股：ZISU HTTP。不要填 zisu.db。
DSH_A_SHARE_WALLET_URL=http://127.0.0.1:8765/api/paper/wallet
DSH_A_SHARE_SCREEN_URL=http://127.0.0.1:8765/api/trade/screen
DSH_A_SHARE_SOURCE_SYSTEM=zisu
DSH_A_SHARE_SOURCE_MODE=paper

DSH_SNAPSHOT_HTTP_TIMEOUT_SEC=3
DSH_SNAPSHOT_STALE_SECONDS=90
DSH_SNAPSHOT_EXPORT_EVERY_SEC=15
