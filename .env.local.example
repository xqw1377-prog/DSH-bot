# 本地联调模板：复制为 .env.local 后由 scripts/start-local.sh 加载。
# 生产环境禁止使用 DSH_ENV=development；缺少 API Key 必须拒绝启动。

# ---- 运行模式 ----
DSH_ENV=development
DSH_LOCAL_PAPER=1

# 开发模式可不配 API Key（开放读写）。若配置，格式：key[/name]:scope,...;...
# QUANT_GATEWAY_API_KEYS=local-dev/local:read,write

# ---- 账户（统一来源；runner 与 Paper 适配器均读此配置）----
PAPER_CRYPTO_ACCOUNT_ID=paper-crypto-001
PAPER_A_SHARE_ACCOUNT_ID=paper-a-share-001
DSH_CRYPTO_ACCOUNT_ID=paper-crypto-001
DSH_CRYPTO_MARKET=CRYPTO

# ---- 数据库（重启可恢复）----
QUANT_GATEWAY_DB=.data/gateway.db
STRATEGY_EVOLUTION_DB=.data/evolution.db
RISK_AUDITOR_DB=.data/risk-auditor.db
DSH_RUNTIME_DB=.data/runtime.db

# ---- 服务地址 ----
QUANT_GATEWAY_URL=http://127.0.0.1:8001
STRATEGY_EVOLUTION_URL=http://127.0.0.1:8002
RISK_POLICY_URL=http://127.0.0.1:8003
PROJECTION_API_URL=http://127.0.0.1:8004
RISK_AUDITOR_URL=http://127.0.0.1:8005
STRATEGY_EVOLUTION_AUDITOR_URL=http://127.0.0.1:8005

# ---- Crypto Bot ----
DSH_CRYPTO_MIN_STRENGTH=0.6
DSH_CRYPTO_TICK_SECONDS=5
# paper=模拟成交；shadow=只读决策不下单
DSH_CRYPTO_MODE=paper
