# 本地联调模板。复制为 .env.local 后由 start-local.sh 加载。
# 不要把真实密钥提交进仓库。

DSH_ENV=development
DSH_LOCAL_PAPER=1
# 控制台 Mode 维度（paper|shadow）。live 不能作为选择项。
# DSH_CRYPTO_MODE=paper
# DSH_A_SHARE_MODE=paper

QUANT_GATEWAY_URL=http://127.0.0.1:8001
STRATEGY_EVOLUTION_URL=http://127.0.0.1:8002
RISK_POLICY_URL=http://127.0.0.1:8003
PROJECTION_API_URL=http://127.0.0.1:8004
RISK_AUDITOR_URL=http://127.0.0.1:8005
STRATEGY_EVOLUTION_AUDITOR_URL=http://127.0.0.1:8005

QUANT_GATEWAY_DB=.data/gateway.db
STRATEGY_EVOLUTION_DB=.data/evolution.db
RISK_AUDITOR_DB=.data/risk-auditor.db
DSH_RUNTIME_DB=.data/runtime.db

PAPER_CRYPTO_ACCOUNT_ID=paper-crypto-001
PAPER_A_SHARE_ACCOUNT_ID=paper-a-share-001
DSH_CRYPTO_ACCOUNT_ID=paper-crypto-001
DSH_A_SHARE_ACCOUNT_ID=paper-a-share-001

# 浏览器不持有这些值。Web BFF / Projection 服务端使用：
# QUANT_GATEWAY_API_KEY=
# 生产 Gateway 必须配置 principals（start-backends.sh 失败关闭）：
# QUANT_GATEWAY_API_KEYS=key/name:read,write
# QUANT_GATEWAY_READ_ONLY=0
# QUANT_GATEWAY_SNAPSHOT_DIR=infra/snapshots
# 公开行情只读叠加（无密钥、不下单）。失败则 freshness 失败关闭：
# QUANT_GATEWAY_PUBLIC_TICKER_URL=https://api.binance.com/api/v3/ticker/price?symbol={symbol}
# 双量化只读快照桥（Shadow）：见 .env.shadow.example
# QUANT_GATEWAY_SNAPSHOT_DIR=.data/shadow-snapshots
# QUANT_GATEWAY_READ_ONLY=1
# DSH_CRYPTO_MODE=shadow
# DSH_A_SHARE_MODE=shadow
# DSH_CRYPTO_STATE_JSON=
# DSH_A_SHARE_WALLET_URL=http://127.0.0.1:8765/api/paper/wallet
# DSH_A_SHARE_SCREEN_URL=http://127.0.0.1:8765/api/trade/screen
# 现有币量化系统只读 HTTP（写入 403，不是实盘下单）：
# QUANT_CRYPTO_READONLY_URL=http://127.0.0.1:9000
# DSH_CRYPTO_MODE=paper
# live 已禁用。本地写 BFF 使用（仅 DSH_ENV=development）：
# DSH_DEV_USER=dev-user
# DSH_SESSION_USER=  # 仅 development 兼容路径；生产忽略，不得当 IAP
# 生产必须配置 IAP（issuer / audience / JWKS），否则身份失败关闭：
# DSH_IAP_ISSUER=https://iap.example.com
# DSH_IAP_AUDIENCE=dsh-bot-console
# DSH_IAP_JWKS_URL=https://iap.example.com/jwks.json
# DSH_IAP_JWKS_ALLOWED_HOSTS=iap.example.com
# DSH_IAP_JWT_HEADER=x-goog-iap-jwt-assertion
# DSH_WEB_ORIGIN=https://bot.example.com
