{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-bot.local/schemas/approval/approved.json",
  "title": "ApprovalApproved",
  "type": "object",
  "required": [
    "approval_id",
    "decided_by",
    "decided_at"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "decided_by": {
      "type": "string",
      "description": "人工身份，禁止填 bot"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    }
  }
}
