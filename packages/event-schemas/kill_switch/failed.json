{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-bot.local/schemas/kill_switch/failed.json",
  "title": "KillSwitchFailed",
  "type": "object",
  "required": ["incident_id", "market", "attempt", "reason", "will_retry"],
  "properties": {
    "incident_id": { "type": "string" },
    "market": { "type": "string", "enum": ["A_SHARE", "CRYPTO", "GLOBAL"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "reason": { "type": "string" },
    "will_retry": { "type": "boolean" },
    "next_retry_at": { "type": ["string", "null"], "format": "date-time" },
    "requires_human_alert": { "type": "boolean" }
  },
  "additionalProperties": false
}
