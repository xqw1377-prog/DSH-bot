{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-bot.local/schemas/experiment/started.json.json",
  "title": "ExperimentStarted",
  "type": "object",
  "required": [
    "experiment_id",
    "market",
    "strategy_id",
    "hypothesis"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "enum": [
        "A_SHARE",
        "CRYPTO"
      ]
    },
    "strategy_id": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "data_snapshot_id": {
      "type": "string"
    },
    "created_by_bot": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
