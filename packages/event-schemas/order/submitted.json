{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-bot.local/schemas/order/submitted.json",
  "title": "OrderSubmitted",
  "type": "object",
  "required": [
    "order_id",
    "idempotency_key",
    "market",
    "approval_id",
    "submitted_at"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "description": "量化系统返回的权威订单 ID"
    },
    "idempotency_key": {
      "type": "string",
      "description": "幂等键，格式为 <prefix>-<uuid hex>，如 crypto-paper-a1b2c3..."
    },
    "market": {
      "type": "string",
      "enum": [
        "A_SHARE",
        "CRYPTO"
      ]
    },
    "approval_id": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
