{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-bot.local/schemas/market/chief.summary.json",
  "title": "MarketChiefSummary",
  "type": "object",
  "required": ["as_of", "markets"],
  "properties": {
    "as_of": { "type": "string", "format": "date-time" },
    "markets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["market", "system_ok"],
        "properties": {
          "market": { "type": "string", "enum": ["A_SHARE", "CRYPTO", "GLOBAL"] },
          "system_ok": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "pending_approvals": { "type": "integer" }
  }
}
