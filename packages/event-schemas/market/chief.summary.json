{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-bot.local/schemas/market/chief.summary.json",
  "title": "MarketChiefSummary",
  "type": "object",
  "required": [
    "markets",
    "pending_approvals",
    "degraded"
  ],
  "properties": {
    "markets": {
      "type": "object"
    },
    "pending_approvals": {
      "type": "integer"
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bots": {
      "type": "object",
      "description": "各 Bot 健康度：tick_failed_recent / tasks 分布 / health",
      "additionalProperties": {
        "type": "object"
      }
    },
    "open_incidents": {
      "type": "integer",
      "description": "未决事故数（opened - resolved/mitigated，近似）"
    },
    "intelligence": {
      "type": "object",
      "description": "主动情报汇总：总量、高优先级计数、前几条重点情报。",
      "additionalProperties": true
    },
    "latest_audits": {
      "type": "array",
      "description": "最近结构化审计报告。",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
