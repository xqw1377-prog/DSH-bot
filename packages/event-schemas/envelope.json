{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-bot.local/schemas/envelope.json",
  "title": "DomainEventEnvelope",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "market",
    "actor",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "account/mismatch",
        "account/reconciled",
        "approval/approved",
        "approval/rejected",
        "approval/requested",
        "audit/report.generated",
        "bot/task.created",
        "bot/task.transitioned",
        "bot/tick.failed",
        "bot/tick.finished",
        "bot/tick.started",
        "candidate/nominated",
        "candidate/rejected",
        "candidate/validated",
        "experiment/completed",
        "experiment/invalidated",
        "experiment/started",
        "incident/mitigated",
        "incident/opened",
        "incident/resolved",
        "intelligence/impact.assessed",
        "intelligence/ingested",
        "intelligence/shadow.recorded",
        "kill_switch/failed",
        "kill_switch/requested",
        "kill_switch/resumed",
        "kill_switch/succeeded",
        "market/chief.briefing",
        "market/chief.summary",
        "market/snapshot.created",
        "order/acknowledged",
        "order/cancelled",
        "order/filled",
        "order/intent.created",
        "order/partially_filled",
        "order/rejected",
        "order/submitted",
        "order/unknown",
        "risk/evaluated",
        "signal/generated",
        "strategy/hypothesis.created",
        "strategy/promoted",
        "strategy/rolled_back"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "market": {
      "type": "string",
      "enum": [
        "A_SHARE",
        "CRYPTO",
        "GLOBAL"
      ]
    },
    "actor": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user",
            "bot",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "strategy_version": {
      "type": "string"
    },
    "data_version": {
      "type": "string"
    },
    "permission_context": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "schema_version": {
      "type": "integer",
      "default": 1,
      "description": "事件契约版本，为未来升级预留兼容能力"
    }
  }
}
