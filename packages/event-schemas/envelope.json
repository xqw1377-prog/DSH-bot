{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-bot.local/schemas/envelope.json",
  "title": "DomainEventEnvelope",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "market", "actor", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": {
      "type": "string",
      "enum": [
        "market/snapshot.created",
        "market/chief.summary",
        "signal/generated",
        "risk/evaluated",
        "risk/limit_breached",
        "order/intent.created",
        "approval/requested",
        "approval/approved",
        "approval/rejected",
        "order/submitted",
        "order/acknowledged",
        "order/partially_filled",
        "order/filled",
        "order/cancelled",
        "order/rejected",
        "order/unknown",
        "account/reconciled",
        "account/mismatch",
        "bot/task.created",
        "bot/task.transitioned",
        "bot/tick.started",
        "bot/tick.finished",
        "bot/tick.failed",
        "strategy/hypothesis.created",
        "experiment/started",
        "experiment/completed",
        "experiment/invalidated",
        "candidate/nominated",
        "candidate/validated",
        "candidate/rejected",
        "strategy/promoted",
        "strategy/rolled_back",
        "incident/opened",
        "incident/mitigated",
        "incident/resolved",
        "kill_switch/requested",
        "kill_switch/succeeded",
        "kill_switch/failed"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "market": { "type": "string", "enum": ["A_SHARE", "CRYPTO", "GLOBAL"] },
    "actor": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["user", "bot", "system"] },
        "id": { "type": "string" }
      }
    },
    "strategy_version": { "type": "string" },
    "data_version": { "type": "string" },
    "permission_context": { "type": "string" },
    "correlation_id": { "type": "string" },
    "payload": { "type": "object" }
  }
}
